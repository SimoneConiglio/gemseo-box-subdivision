-                solver.Add(constraint <= ub)
+                self.__add_row(solver, variables, coefficients, -solver.infinity(), ub)
         # add equality constraints with eq. tolerance
         for cc, lb, ub in zip(
             eq_lhs,
@@ -143,11 +184,11 @@ class OrtoolsMILP(BaseOptimizationLibrary[OrtoolsMilp_Settings]):
             eq_rhs + self._settings.eq_tolerance,
             strict=False,
         ):
-            constraint = sum(c * x for c, x in zip(cc, variables, strict=False))
+            coefficients = cc.tolist()
             if not isinf(lb):
-                solver.Add(constraint >= lb)
+                self.__add_row(solver, variables, coefficients, lb, solver.infinity())
             if not isinf(ub):
-                solver.Add(constraint <= ub)

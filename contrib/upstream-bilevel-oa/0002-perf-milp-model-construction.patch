@@ -82,6 +84,39 @@ class OrtoolsMILP(BaseOptimizationLibrary[OrtoolsMilp_Settings]):
     def __init__(self, algo_name: str = "ORTOOLS_MILP") -> None:  # noqa:D107
         super().__init__(algo_name)
 
+    @staticmethod
+    def __add_row(
+        solver: pywraplp.Solver,
+        variables: Sequence[pywraplp.Variable],
+        coefficients: Sequence[float],
+        lower_bound: float,
+        upper_bound: float,
+    ) -> None:
+        """Add one linear constraint row to the solver.
+
+        The coefficients are handed to the solver one at a time rather than
+        accumulated into a Python expression. ``sum(c * x for c, x in ...)``
+        allocates a temporary product and a temporary sum per coefficient, and
+        it is handed NumPy scalars, whose operators dispatch through NumPy
+        before reaching the solver's. The master rebuilds this model at every
+        iteration and its cut set grows as it goes, so the cost is paid again
+        and again, over a matrix that grows with the run.
+
+        Args:
+            solver: The solver to add the row to.
+            variables: The variables of the problem, in the order of the
+                coefficients.
+            coefficients: The coefficient of each variable.
+            lower_bound: The lower bound of the row.
+            upper_bound: The upper bound of the row.
+        """
+        row = solver.RowConstraint(lower_bound, upper_bound)
+        for coefficient, variable in zip(coefficients, variables, strict=False):
+            # A coefficient of zero is the absence of the variable from the row,
+            # so the solver is not told about it.
+            if coefficient:
+                row.SetCoefficient(variable, coefficient)
+
     def _run(self, problem: OptimizationProblem) -> tuple[Any, Any]:
         # Get the starting point and bounds
         _x_0, l_b, u_b = get_value_and_bounds(
@@ -125,17 +160,23 @@ class OrtoolsMILP(BaseOptimizationLibrary[OrtoolsMilp_Settings]):
                     solver.NumVar(xl, xu, self.VAR_PREFIX + str(count + 1))
                 )
         # define the objective function
-        objective = sum(c * x for c, x in zip(obj_coeff, variables, strict=False))
-        solver.Minimize(objective)
+        # N.B. the coefficients are set on the solver's own objective rather
+        # than accumulated into a Python expression: ``sum(c * x for ...)``
